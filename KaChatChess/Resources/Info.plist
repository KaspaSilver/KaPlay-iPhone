<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AppIdentifierPrefix</key>
	<string>$(AppIdentifierPrefix)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.kachat.chess</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>kachatchess</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(KACHAT_BUILD_NUMBER)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>KaChatIsRelease</key>
	<string>$(KACHAT_IS_RELEASE)</string>
	<key>NFCReaderUsageDescription</key>
	<string>KaPlay uses NFC to save and restore an encrypted backup of your 12 or 24 words on your smart card.</string>
	<!-- KaChat-NFC's applet first, then the card manager, which only tells a card that hasn't been
	     loaded yet from one that isn't a smart card. iOS only reports a card as an ISO 7816 tag
	     when it answers one of these. See NFCCard.swift. -->
	<key>com.apple.developer.nfc.readersession.iso7816.select-identifiers</key>
	<array>
		<string>F04B41434841544E464301</string>
		<string>A000000151000000</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>KaPlay uses the camera to scan a Kaspa address QR code when you send KAS.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Face ID confirms sends and deleting an account. When enabled in Settings, it also unlocks your 12 or 24 words and signs you back in.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>KaPlay connects to a Kaspa node on your local network only if you set one up in Settings &gt; Connection.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>
